# Copy to .env for local runs. NEVER commit real keys.
PORT=8000
WITNESS_STAGE=3

# Optional overrides
# WITNESS_DATA_DIR=./data
# AUDIT_DB=./data/audit.db

# Component flags (swap adapters without code changes)
READER=text
EXTRACTOR=fixture
VERIFIER=det
AUDIT=sqlite

# LLM adapters (Stage 2). Set EXTRACTOR=llm and/or VERIFIER=llm to enable.
# If the key is missing or the API call fails, Witness falls back to the
# deterministic fixture/deterministic path so a case is never dropped.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=20
