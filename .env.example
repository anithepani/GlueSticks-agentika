# Copy to .env for local runs. NEVER commit real keys.
PORT=8000
WITNESS_STAGE=4

# Optional overrides
# WITNESS_DATA_DIR=./data
# AUDIT_DB=./data/audit.db
# WITNESS_STRICT=1          # refuse to serve if the evaluation gate fails
# WITNESS_SLA_HOURS=24      # case queue SLA
# WITNESS_MAX_PDF_PAGES=20
# WITNESS_MAX_PDF_B64=4000000
# WITNESS_MAX_INTAKE=50

# Component flags (swap adapters without code changes)
READER=pdf
EXTRACTOR=llm
VERIFIER=llm
AUDIT=postgres

# LLM adapters. If the key is missing or a call fails, Witness falls back to the
# deterministic label/fixture path so a case is never dropped.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=20

# Postgres audit (only when AUDIT=postgres). Injected automatically by
# `acc services link` as DATABASE_URL / POSTGRES_URL, or set it here.
# DATABASE_URL=postgres://user:pass@host:5432/db
