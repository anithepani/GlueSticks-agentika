# Copy to .env for local runs. NEVER commit real keys.
PORT=8000
WITNESS_STAGE=1

# Optional overrides
# WITNESS_DATA_DIR=./data
# AUDIT_DB=./data/audit.db

# Component flags (swap adapters without code changes)
READER=text
EXTRACTOR=fixture
VERIFIER=det
AUDIT=sqlite

# Free LLM providers (Stage 2+). Leave blank to stay in fixture mode.
GROQ_API_KEY=
GEMINI_API_KEY=
